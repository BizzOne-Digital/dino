# Copy to .env.local and fill in values:
#   copy .env.example .env.local   (Windows)
#   cp .env.example .env.local     (macOS/Linux)

# Required — MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/dino?retryWrites=true&w=majority

# Required for Next.js / admin login (generate: openssl rand -base64 32)
AUTH_SECRET=

# Public site URL (local dev)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Seed script — first admin user (optional; defaults shown)
INITIAL_ADMIN_EMAIL=admin@dinoscookiesandbagels.ca
INITIAL_ADMIN_PASSWORD=ChangeMe123!

# Cloudinary (admin product uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Stripe
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (order notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_APP_PASSWORD=
ADMIN_NOTIFICATION_EMAIL=sales@dinoscookiesandbagels.ca
